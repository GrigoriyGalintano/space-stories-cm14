<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:phrases="clr-namespace:Content.Client._Stories.CustomPhrases"
    Title="{Loc 'stories-custom-phrases-edit-title'}"
    SetSize="460 420"
    MinSize="360 360">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Text="{Loc 'stories-custom-phrases-text-label'}" HorizontalExpand="True" />
            <Label Name="CounterLabel" StyleClasses="LabelSubText" />
        </BoxContainer>

        <PanelContainer VerticalExpand="True" MinHeight="100">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#1E1E24" BorderColor="#4A4A55" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <TextEdit Name="TextInput" VerticalExpand="True" HorizontalExpand="True" Margin="4" />
        </PanelContainer>
        <RichTextLabel Text="{Loc 'stories-custom-phrases-hint'}" HorizontalExpand="True" />

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Text="{Loc 'stories-custom-phrases-tags-label'}" HorizontalExpand="True" />
            <Label Name="TagsCounterLabel" StyleClasses="LabelSubText" />
        </BoxContainer>
        <LineEdit Name="TagsEdit" PlaceHolder="{Loc 'stories-custom-phrases-tags-placeholder'}" HorizontalExpand="True" />
        <phrases:WrapContainer Name="KnownTagsContainer" HorizontalExpand="True" />

        <Label Name="ErrorLabel" FontColorOverride="#DD4444" Visible="False" />

        <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
            <Button Name="SaveButton" Text="{Loc 'stories-custom-phrases-save'}" HorizontalExpand="True" MinHeight="30" />
            <Button Name="CancelButton" Text="{Loc 'stories-custom-phrases-cancel'}" HorizontalExpand="True" MinHeight="30" />
            <controls:ConfirmButton Name="DeleteButton" MinHeight="30" Visible="False" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
