<BoxContainer
    xmlns="https://spacestation14.io"
    Orientation="Horizontal"
    HorizontalExpand="True"
    SeparationOverride="4">
    <ContainerButton Name="SendButton" HorizontalExpand="True" StyleClasses="button">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6 3">
            <RichTextLabel Name="TextLabel" HorizontalExpand="True" />
            <Label Name="TagsLabel" ClipText="True" HorizontalExpand="True" StyleClasses="LabelSubText" />
        </BoxContainer>
    </ContainerButton>
    <TextureButton Name="EditButton"
                   TexturePath="/Textures/Interface/pencil.png"
                   VerticalAlignment="Center"
                   Margin="2 0"
                   ToolTip="{Loc 'stories-custom-phrases-edit'}" />
</BoxContainer>
