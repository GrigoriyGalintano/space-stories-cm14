<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:phrases="clr-namespace:Content.Client._Stories.CustomPhrases"
    Title="{Loc 'stories-custom-phrases-title'}"
    SetSize="440 540"
    MinSize="340 300">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
            <LineEdit Name="SearchBar" PlaceHolder="{Loc 'stories-custom-phrases-search-placeholder'}" HorizontalExpand="True" />
            <Button Name="AddButton" Text="{Loc 'stories-custom-phrases-add'}" />
        </BoxContainer>

        <phrases:WrapContainer Name="TagsContainer" HorizontalExpand="True" />

        <ProgressBar Name="CooldownBar" MinValue="0" MaxValue="1" Value="0" MinHeight="4" HorizontalExpand="True" />

        <Label Name="EmptyLabel" Text="{Loc 'stories-custom-phrases-empty'}" StyleClasses="LabelSubText"
               HorizontalAlignment="Center" Visible="False" />

        <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Name="PhrasesContainer" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
