ent-RMCSleeper = слипер
    .desc = Навороченная кровать со встроенными инъекторами, аппаратом диализа и ограниченным сканером здоровья.
    .suffix = С консолью
ent-RMCSleeperNoConsole = { ent-RMCSleeper }
    .desc = { ent-RMCSleeper.desc }
    .suffix = Без консоли
ent-RMCSleeperConsole = консоль слипера
    .desc = Консоль управления слипером. Позволяет вводить химикаты и проводить диализ.
ent-RMCSleeperAdvanced = продвинутый слипер
    .desc = Более дорогая модель слипера с дополнительными химикатами и продвинутым аппаратом диализа, который выводит химикаты гораздо быстрее и больше за раз.
    .suffix = Улучшенная консоль
ent-RMCSleeperConsoleUpgraded = улучшенная консоль слипера
    .desc = { ent-RMCSleeperConsole.desc }
