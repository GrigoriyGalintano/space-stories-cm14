ent-RMCBulletPistolHandcannon = пуля ( .50 )
    .desc = { ent-CMBulletBase.desc }
ent-RMCBulletPistolHandcannonHI = пуля ( Повышенной мощности .50 )
    .desc = { ent-CMBulletBase.desc }
